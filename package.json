{
  "name": "advancedplaywrightframework1x",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test --grep @e2e",
    "test:p0": "playwright test --grep @P0",
    "test:report": "playwright test --reporter=html && playwright show-report",
    "allure:generate": "playwright test --reporter=line,allure-playwright",
    "allure:report": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "test:report:ci": "playwright test --reporter=line,junit --output=test-results",
    "lint": "npx eslint .",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --write .",
    "build": "tsc",
    "clean": "node -e \"const fs=require('fs'); ['test-results','playwright-report','allure-results','allure-report'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}));\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.9.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
