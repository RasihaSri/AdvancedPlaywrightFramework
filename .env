# Environment selection: local | dev | qa | stg | prod
ENV=qa

# Optional explicit override used by playwright.config.ts
# BASE_URL=https://example.com

# Base URLs per environment
DEV_BASE_URL=http://localhost:3000
QA_BASE_URL=http://qa.thetestingacademy.com
STG_BASE_URL=http://stage.thetestingacademy.com
PROD_BASE_URL=http://app.thetestingacademy.com

# Logger level for Winston
LOG_LEVEL=info
